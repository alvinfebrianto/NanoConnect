# Supabase Configuration (frontend)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Configuration (backend fallback; can match VITE_* values)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Configuration (backend only - Node Functions)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# Comma-separated for multiple keys (auto-rotation support)
# GOOGLE_GENERATIVE_AI_API_KEY=key1,key2,key3
AI_MODEL=gemini-2.5-flash-lite
